# Copia este archivo a .env. Para usar Gemini, agrega tu propia clave.
FERTILIX_API_KEY=
FERTILIX_PROVIDER=gemini
FERTILIX_MODEL=gemini-3.8-flash
FERTILIX_VISION_MODEL=gemini-3.5-flash-lite

# Puerto serial del Arduino o módulo Bluetooth SPP. Ejemplos:
# ARDUINO_PORT=COM7
# ARDUINO_PORT=/dev/rfcomm0
